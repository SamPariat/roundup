# Template for .env.prod. Copy to .env.prod and fill in; never commit the copy.
# Deployed containers should get these as real environment variables instead.
PORT="3001"
POSTGRES_DSN="postgres://<user>:<password>@<prod-db-host>:5432/auth?sslmode=require"
USER_SERVICE_URL="http://<user-service-host>:3002"
# A prod-only keypair, separate from beta's. PEM, or one line with \n escapes.
JWT_PRIVATE_KEY="<prod Ed25519 private key PEM>"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="720h"
# OTP_DEV_CODE must NOT be set in prod.
LOG_LEVEL="info"
