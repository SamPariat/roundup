PORT="3001"
POSTGRES_DSN="postgres://auth_user:auth_pass@localhost:5433/auth"
USER_SERVICE_URL="http://localhost:3002"
# Filled in by `make jwt-keys`. Never commit a real key.
JWT_PRIVATE_KEY=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="720h"
# Accepted as a valid code for any phone after a code is requested.
# Beta only: auth-service refuses to start if this is set with APP_ENV=prod.
OTP_DEV_CODE="123456"
LOG_LEVEL="debug"
