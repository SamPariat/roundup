# Template for .env.prod. Copy to .env.prod and fill in; never commit the copy.
# Deployed containers should get these as real environment variables instead.
PORT="8080"
REDIS_ADDR="<prod-redis-host>:6379"
LOG_LEVEL="info"
AUTH_SERVICE_URL="http://<auth-service-host>:3001"
USER_SERVICE_URL="http://<user-service-host>:3002"
VENUE_SERVICE_URL="http://<venue-service-host>:3006"
UPSTREAM_TIMEOUT="10s"
# Public half of the prod Ed25519 keypair (never beta's).
JWT_PUBLIC_KEY="<prod Ed25519 public key PEM>"
